    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#F8C8DC',
                        secondary: '#D4A5A5',
                        accent: '#C1D7AE',
                    },
                    fontFamily: {
                        display: ['"Playfair Display"', 'serif'],
                        body: ['"Quicksand"', 'sans-serif'],
                        decorative: ['"Dancing Script"', 'cursive']
